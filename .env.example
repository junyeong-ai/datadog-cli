# Export these variables in your shell; datadog-cli does not load .env files.
# Offline capabilities commands do not read configuration or execute credential providers.
# Reviewed query operations use the same explicit authentication and site selection.
# Use an API/Application key pair or DD_TOKEN (PAT, SAT, or OAuth access token).
# Choose api-keys, token, or oauth through global config.toml [auth].method or --auth-method.
# OAuth uses a named Pup session; unrelated static credentials are ignored.
# Pup owns refresh; CLI provider calls for one site share a bounded OS lock.
DD_API_KEY=your_api_key
DD_APP_KEY=your_app_key
# DD_TOKEN=your_token
DD_SITE=datadoghq.com

# Tag prefixes retained by logs search, spans, RUM, and hosts.
# This controls tag output only, not record selection, pagination, or custom attributes.
# Empty excludes tags; * retains all tags; unset inherits the config filter.
DD_TAG_FILTER=env:,service:
RUST_LOG=warn
